    <!-- ══════════════════════════════════════════════════════════════════
         LAYER 3 — BACKEND (Node.js + Express + TypeScript)
    ══════════════════════════════════════════════════════════════════ -->
    <mxCell id="backend" value="🖥  BACKEND  —  Node.js 20  +  Express 4  +  TypeScript  (REST API Server)"
      style="swimlane;startSize=36;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=14;fontColor=#5c3200;arcSize=2;"
      vertex="1" parent="1">
      <mxGeometry x="20" y="1143" width="2200" height="395" as="geometry" />
    </mxCell>

    <mxCell id="index_ts" value="&lt;b&gt;index.ts&lt;/b&gt; — Express App&lt;br/&gt;────────────────────&lt;br/&gt;app.use(helmet())&lt;br/&gt;app.use(cors({&lt;br/&gt;  origin: FRONTEND_URL&lt;br/&gt;}))&lt;br/&gt;app.use(morgan('combined'))&lt;br/&gt;app.use(express.json())&lt;br/&gt;────────────────────&lt;br/&gt;GET  /health&lt;br/&gt;/api/auth    → authRouter&lt;br/&gt;/api/channels → channelRouter&lt;br/&gt;/api/meetings → meetingRouter&lt;br/&gt;────────────────────&lt;br/&gt;app.use(errorMiddleware)&lt;br/&gt;app.listen(PORT)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=8;arcSize=4;"
      vertex="1" parent="backend">
      <mxGeometry x="30" y="52" width="296" height="300" as="geometry" />
    </mxCell>

    <mxCell id="auth_route" value="&lt;b&gt;auth.route.ts&lt;/b&gt;&lt;br/&gt;────────────────────&lt;br/&gt;&lt;b&gt;POST /api/auth/token&lt;/b&gt;&lt;br/&gt;body: { userId, userName, userImage? }&lt;br/&gt;→ serverClient.upsertUser({ id, name, image })&lt;br/&gt;→ serverClient.createToken(userId, exp+24h)&lt;br/&gt;← { token, userId, userName, apiKey }&lt;br/&gt;────────────────────&lt;br/&gt;&lt;b&gt;POST /api/auth/guest&lt;/b&gt;&lt;br/&gt;→ auto-gen guest_XXXXXXXX&lt;br/&gt;→ upsertUser + createToken (24h)&lt;br/&gt;← { token, userId, userName }"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=8;arcSize=4;"
      vertex="1" parent="backend">
      <mxGeometry x="346" y="52" width="444" height="255" as="geometry" />
    </mxCell>

    <mxCell id="ch_route" value="&lt;b&gt;channel.route.ts&lt;/b&gt;&lt;br/&gt;────────────────────&lt;br/&gt;&lt;b&gt;POST /api/channels&lt;/b&gt;&lt;br/&gt;body: { name, createdById, members[], desc }&lt;br/&gt;→ channelId = uuid().replace(/-/g,'').slice(0,24)&lt;br/&gt;→ allMembers = [createdById, ...members]&lt;br/&gt;→ serverClient.channel('messaging', id, {&lt;br/&gt;    name, description, created_by_id, members&lt;br/&gt;  })&lt;br/&gt;→ channel.create()&lt;br/&gt;← 201 { channelId, name, members }"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=8;arcSize=4;"
      vertex="1" parent="backend">
      <mxGeometry x="808" y="52" width="440" height="255" as="geometry" />
    </mxCell>

    <mxCell id="mt_route" value="&lt;b&gt;meeting.route.ts&lt;/b&gt;&lt;br/&gt;────────────────────&lt;br/&gt;&lt;b&gt;POST /api/meetings&lt;/b&gt;&lt;br/&gt;body: { createdById, callId?, title? }&lt;br/&gt;→ meetingCallId = callId ?? uuid()&lt;br/&gt;← 201 { callId, callType, joinUrl }&lt;br/&gt;────────────────────&lt;br/&gt;&lt;b&gt;GET /api/meetings/:callId&lt;/b&gt;&lt;br/&gt;← { callId, callType, joinUrl }&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;(no server-side state)&lt;/font&gt;"
